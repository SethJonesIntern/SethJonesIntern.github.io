---
import { FOOTER_LINKS, SITE_AFFILIATION, SITE_AUTHOR } from '../consts';

// Build-time year; there is no client-side JavaScript to update it.
const copyright = `© ${new Date().getFullYear()} ${SITE_AUTHOR}`;
---

<footer class="site-footer">
  <div class="container">
    <p class="site-footer__line">{copyright}</p>
    <p class="site-footer__line site-footer__affiliation">{SITE_AFFILIATION}</p>
    {
      FOOTER_LINKS.length > 0 && (
        <ul class="site-footer__links">
          {FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
