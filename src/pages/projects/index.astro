---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GITHUB_PROFILE_URL, selectShowcaseRepos } from '../../lib/github';
import { fetchShowcaseRepos } from '../../lib/github-fetch';
import { formatStack, projectHref, sortProjects, statusLabel } from '../../lib/projects';

// Space, U+00B7 MIDDLE DOT, space — matches TITLE_SEPARATOR and formatStack.
const META_SEPARATOR = ' · ';

// Filtering keeps the separator from doubling if a part ever comes back empty.
function metaLine(data: CollectionEntry<'projects'>['data']): string {
  return [data.role.trim(), statusLabel(data.status), formatStack(data.stack)]
    .filter((part) => part !== '')
    .join(META_SEPARATOR);
}

// getCollection nests frontmatter under `data`, but sortProjects reads the sort
// keys off the top level, so project them and carry the entry alongside.
const projects = sortProjects(
  (await getCollection('projects')).map((entry) => ({
    id: entry.id,
    order: entry.data.order,
    title: entry.data.title,
    entry,
  })),
);

// One unauthenticated request at build time. fetchShowcaseRepos absorbs every
// failure, so there is nothing to catch here: a bad response just leaves
// `repos` empty and the section falls back to a single paragraph.
const { ok, repos, reason } = await fetchShowcaseRepos();
const showcase = selectShowcaseRepos(repos);

if (!ok) {
  console.warn(`projects: GitHub showcase unavailable — ${reason ?? 'unknown reason'}`);
}
---

<BaseLayout
  title="Projects"
  description="Software projects by Seth Jones: a Python honeynet backend, embedded C++ for the T-SAT 2A satellite payload, and a real-time multiplayer typing game."
>
  <h1>Projects</h1>
  <p>Things I have built outside of research — a honeynet backend, a satellite payload's flight code, and a multiplayer game written over one weekend. Each one has a page with what it was and what I did on it.</p>
  {
    projects.length === 0 ? (
      <p>No projects are listed here yet.</p>
    ) : (
      <div class="project-list">
        {projects.map(({ id, entry }) => (
          <article class="project-card">
            <h2><a href={projectHref(id)}>{entry.data.title}</a></h2>
            <p class="project-card__meta">{metaLine(entry.data)}</p>
            <p>{entry.data.summary}</p>
          </article>
        ))}
      </div>
    )
  }
  <h2>From GitHub</h2>
  <p>This list is read from my public GitHub account once, when the site is deployed, and ordered by stars and then by most recent push.</p>
  {
    showcase.length === 0 ? (
      <p>Live repository data is not available right now. My work is on <a href={GITHUB_PROFILE_URL} rel="noopener">GitHub</a>.</p>
    ) : (
      <ul class="repo-list">
        {showcase.map((repo) => (
          <li class="repo-card">
            <h3><a href={repo.url} rel="noopener">{repo.name}</a></h3>
            {repo.meta !== '' && <p class="repo-card__meta">{repo.meta}</p>}
            {repo.description && <p>{repo.description}</p>}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
    background: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  /* The global h2 size is tuned for a section heading, not a card title. */
  .project-card h2 {
    font-size: var(--text-lg);
  }

  .project-card h2 a {
    text-decoration: none;
  }

  /* Class-level specificity so the global `a:visited` cannot recolour a card
     title once the detail page has been read. */
  .project-card h2 a:visited {
    color: var(--color-link);
  }

  .project-card h2 a:hover {
    color: var(--color-link-hover);
  }

  .project-card__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Mirrors the .project-card treatment; a list because the repos are a plain
     enumeration rather than standalone articles with their own pages. */
  .repo-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .repo-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-md);
    background: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  /* The global h3 size is tuned for a section subheading, not a card title. */
  .repo-card h3 {
    font-size: var(--text-lg);
  }

  .repo-card h3 a {
    text-decoration: none;
  }

  /* Class-level specificity so the global `a:visited` cannot recolour a card
     title once the repository has been opened. */
  .repo-card h3 a:visited {
    color: var(--color-link);
  }

  .repo-card h3 a:hover {
    color: var(--color-link-hover);
  }

  .repo-card__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
